<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Video Website</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f0f0f0;
            margin: 0;
            padding: 20px;
        }
        h1 {
            color: #333;
        }
        video {
            max-width: 100%;
            height: auto;
            border: 2px solid #ccc;
            border-radius: 8px;
            opacity: 0;
            transition: opacity 1s ease-in-out;
        }
        video.playing {
            opacity: 1;
        }
        button {
            margin-top: 10px;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <h1>Welcome to My Animated Video Site</h1>
    <p>Click play to see the animation!</p>
    <video id="animatedVideo" controls>
        <source src="animated-video.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    <br>
    <button onclick="playVideo()">Play with Animation</button>

    <script>
        function playVideo() {
            const video = document.getElementById('animatedVideo');
            video.classList.add('playing');
            video.play();
        }
    </script>
</body>
</html>
